# IEEE ICAD 2026 Workshop — environment configuration
# Copy this file to .workshop-env and fill in the values:
#   cp .workshop-env.example .workshop-env
#
# Source before each workshop session:
#   source .workshop-env
#
# .workshop-env is in .gitignore — your credentials will NOT be committed.

# =============================================================================
# Model endpoint — choose ONE of the three options below and uncomment it.
# Any OpenAI-compatible chat/completions endpoint works.
# =============================================================================

# --- Option A: OpenRouter (recommended — free tier, cloud inference, no GPU) ---
# Get a free key at: https://openrouter.ai/keys
export MODEL_ENDPOINT="https://openrouter.ai/api/v1"
export MODEL_NAME="liquid/lfm-2.5-1.2b-instruct:free"
export OPENROUTER_API_KEY="sk-or-v1-REPLACE-WITH-YOUR-KEY"
export OPENAI_API_KEY="${OPENROUTER_API_KEY}"   # lm-eval uses this header internally

# --- Option B: Ollama (local, no API key, requires GPU or fast CPU) ----------
# Run before the workshop: ollama pull llama3.2:3b && ollama serve
# export MODEL_ENDPOINT="http://localhost:11434/v1"
# export MODEL_NAME="llama3.2:3b"
# export OPENAI_API_KEY="ollama"   # Ollama accepts any non-empty value

# --- Option C: vLLM (local or institutional endpoint) ------------------------
# export MODEL_ENDPOINT="http://localhost:8000/v1"
# export MODEL_NAME="<model-id-as-registered-in-vllm>"
# export OPENAI_API_KEY="<your-token-if-required>"

# =============================================================================
# eval-hub-server local port (started by 01-setup/setup.sh)
# Port 18080 avoids conflicts with common macOS services on 8080.
# =============================================================================
export EVALHUB_LOCAL_PORT="18080"

# =============================================================================
# These are filled automatically by setup.sh — do not edit manually.
# =============================================================================
export EVALHUB_ENDPOINT="http://localhost:${EVALHUB_LOCAL_PORT}"
export EVALHUB_TOKEN=""

# Path to the workshop directory (used by scripts to locate other files)
export WORKSHOP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
